#!/bin/sh
# Generated by zefosator: install {{ plan.target_id }} packages from a local priority repo and check them.
set -u
failed=0
check() {
    name=$1
    shift
    if "$@" > /tmp/check.log 2>&1; then
        echo "PASS $name"
    else
        echo "FAIL $name"
        tail -n 30 /tmp/check.log | sed 's/^/    /'
        failed=1
    fi
}

echo "==> Preparing local repository (priority=10) from build output"
cp -a /output /tmp/repo
dnf install -y createrepo_c rpm-build > /tmp/setup.log 2>&1 || { cat /tmp/setup.log; exit 2; }
createrepo_c -q /tmp/repo || exit 2
cat > /etc/yum.repos.d/zefosa-local.repo <<'REPO'
[zefosa-local]
name=zefosa local build
baseurl=file:///tmp/repo
enabled=1
gpgcheck=0
priority=10
REPO

# Repo priority is applied when dnf resolves packages (repoquery still lists every repo), so this
# offers a newer kernel-core from a repo at the vendors' default priority and checks dnf's choice.
preference() {
    mkdir -p /tmp/fake/SPECS /tmp/fake-repo
    cat > /tmp/fake/SPECS/fake.spec <<'SPEC'
Name: kernel-core
Version: 99.0
Release: 1
Summary: Newer upstream kernel stand-in
License: MIT
BuildArch: noarch
%description
Stand-in for a newer upstream kernel.
%files
SPEC
    rpmbuild -bb --quiet --define '_topdir /tmp/fake' --define '_rpmdir /tmp/fake-repo' \
        /tmp/fake/SPECS/fake.spec || return 1
    createrepo_c -q /tmp/fake-repo || return 1
    cat > /etc/yum.repos.d/fake-upstream.repo <<'REPO'
[fake-upstream]
name=newer upstream stand-in
baseurl=file:///tmp/fake-repo
enabled=1
gpgcheck=0
priority=99
REPO
    dnf install --assumeno kernel-core > /tmp/resolve.txt 2>&1
    rm -f /etc/yum.repos.d/fake-upstream.repo
    cat /tmp/resolve.txt
    grep -F {{ (plan.kernel_version ~ "-" ~ plan.zefosa_release) | sh }} /tmp/resolve.txt > /dev/null \
        && ! grep -q '99\.0-1' /tmp/resolve.txt
}

install() {
    dnf install -y kernel zfs || echo "(dnf reported an error; checking installed packages)"
    rpm -q {{ ("kernel-core-" ~ plan.kernel_version ~ "-" ~ plan.zefosa_release) | sh }} zfs zfs-dracut
}

modules() {
    path=$(modinfo -k {{ plan.uname_r | sh }} -n zfs) || return 1
    echo "$path"
    case "$path" in /lib/modules/{{ plan.uname_r }}/extra/*) ;; *) return 1 ;; esac
    grep -q 'extra/.*zfs\.ko' /lib/modules/{{ plan.uname_r | sh }}/modules.dep
}

# Rootless containers cannot set security.* xattrs (EL10 files carry IMA signatures); copying
# them is irrelevant to whether the ZFS dracut module is included.
initramfs() {
    DRACUT_NO_XATTR=1 dracut --no-hostonly --force --kver {{ plan.uname_r | sh }} /tmp/initramfs.img || return 1
    lsinitrd -m /tmp/initramfs.img | grep -qw zfs || return 1
    lsinitrd /tmp/initramfs.img | grep -q 'zfs\.ko'
}

integrity() {
    rpm -V $(rpm -qa 'kernel*' | grep -F {{ plan.zefosa_release | sh }})
}

check preference preference
check install install
check modules modules
check initramfs initramfs
check integrity integrity
exit $failed
