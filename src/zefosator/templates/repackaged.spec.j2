# Generated by zefosator: upstream binary packages rebuilt as-is (payload copied, not compiled).
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __spec_install_post %{nil}
%global __debug_install_post %{nil}
%global _build_id_links none
%undefine _missing_build_ids_terminate_build
%global _binary_payload {{ payload }}
%global _binary_filedigest_algorithm {{ digest_algo }}
# Reproducible: SOURCE_DATE_EPOCH (never older than any vendor file, so vendor file times stay)
# is the build time and caps the times of the files zefosator adds.
%global source_date_epoch_from_changelog 0
%global clamp_mtime_to_source_date_epoch 1
%global use_source_date_epoch_as_buildtime 1
%global _buildhost zefosa
%global _changelog_trimtime 0
%global _changelog_trimage 0

{% for pkg in packages %}
{% if not pkg.is_main %}
%package -n {{ pkg.name }}
{% endif %}
{% for line in pkg.preamble %}
{{ line }}
{% endfor %}
{% for line in pkg.dependencies %}
{{ line }}
{% endfor %}

%description{% if not pkg.is_main %} -n {{ pkg.name }}{% endif %}

{{ pkg.description }}

{% endfor %}
%install
cp -a %{_zefosa_root}/. %{buildroot}/

{% for pkg in packages %}
{% for script in pkg.scripts %}
{{ script.header }}
{% if script.body is not none %}
{{ script.body }}
{% endif %}

{% endfor %}
{% endfor %}
{% for pkg in packages %}
%files{% if not pkg.is_main %} -n {{ pkg.name }}{% endif %}

{% for line in pkg.files %}
{{ line }}
{% endfor %}

{% endfor %}
%changelog
{% for entry in changelog %}
* {{ entry.heading }}
{{ entry.text }}
{% if not loop.last %}

{% endif %}
{% endfor %}
