FROM {{ image.base }}
{% if image.setup_packages %}
RUN dnf install -y {{ image.setup_packages | join(" ") }} && dnf clean all
{% endif %}
RUN dnf install -y {% for repo in image.enable_repos %}--enablerepo={{ repo }} {% endfor %}{{ image.packages | join(" ") }} && dnf clean all
COPY --from=ghcr.io/astral-sh/uv:{{ uv_version }} /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=automatic \
    UV_LINK_MODE=copy
WORKDIR /opt/zefosator
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project --no-dev
