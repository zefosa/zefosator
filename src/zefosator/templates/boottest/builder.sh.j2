#!/bin/bash
# Generated by zefosator boottest: install a root-on-ZFS {{ plan.target_id }} system with the
# zefosa boot chain onto /dev/vdb. Runs in the builder VM at boot; all output goes to the serial log.
exec > /dev/ttyS0 2>&1
set -euxo pipefail
export TERM=dumb
# heartbeat: a stall shows up on the serial log within a minute
( set +x; while sleep 30; do echo "HEARTBEAT $(date +%T) $(ps -eo etimes,comm --sort=-start_time | sed -n 2,4p | tr -s ' ' | tr '\n' ';')"; done ) &
UNAME={{ plan.uname_r | sh }}
D=/dev/vdb
modprobe zfs
sgdisk -Z $D
sgdisk -n1:1M:+300M -t1:EF00 -n2:0:0 -t2:BF00 $D
udevadm settle
sleep 2
mkfs.vfat -F32 -n ESP ${D}1
zgenhostid -f 0x00bab10c
zpool create -f -o ashift=12 -o cachefile=none -O compression=lz4 -O acltype=posixacl -O xattr=sa \
    -O relatime=on -m none zroot ${D}2
zfs create -o mountpoint=none zroot/ROOT
zfs create -o mountpoint=/ -o canmount=noauto zroot/ROOT/os
zpool set bootfs=zroot/ROOT/os zroot
zpool export zroot
zpool import -N -R /mnt zroot
zfs mount zroot/ROOT/os
mkdir -p /mnt/etc /mnt/boot/efi /mnt/dev /mnt/proc /mnt/sys
cp /etc/hostid /mnt/etc/hostid
mount /dev/vdb1 /mnt/boot/efi
mount --bind /dev /mnt/dev
mount -t proc proc /mnt/proc
mount -t sysfs sys /mnt/sys
HOSTCFG=""
if dnf --version 2>/dev/null | grep dnf5 >/dev/null; then HOSTCFG=--use-host-config; fi
dnf --installroot=/mnt --releasever={{ plan.os_major }} $HOSTCFG -y --setopt=install_weak_deps=False \
    install basesystem systemd systemd-udev kmod keyutils mokutil util-linux procps-ng dracut \
    /root/t/rpms/*.rpm 2>&1 | cat
rpm --root=/mnt -q shim-x64 zefosa-boot zefosa-refind zefosa-zfsbootmenu zefosa-zfsbootmenu-recovery
# 20-zbm.install (zefosa-boot) must have placed the kernel where ZFSBootMenu looks
test -f /mnt/boot/vmlinuz-$UNAME
test -f /mnt/boot/initramfs-$UNAME.img
test -f /mnt/boot/efi/EFI/zefosa/shimx64.efi
test -f /mnt/boot/efi/EFI/zefosa/grubx64.efi
test -f /mnt/boot/efi/EFI/zefosa/zfsbootmenu.efi
# a chroot cannot be relied on for hostonly detection of the ZFS root
chroot /mnt dracut -f --no-hostonly --kver $UNAME /boot/initramfs-$UNAME.img
chroot /mnt lsinitrd /boot/initramfs-$UNAME.img > /root/t/initrd.lst
grep -q 'zfs\.ko' /root/t/initrd.lst
chroot /mnt zefosa-boot setup --pool zroot --esp /boot/efi --no-firmware --no-mok
sed -i 's/zbm.timeout=5 ro quiet loglevel=0/zbm.timeout=2 console=ttyS0,115200 loglevel=6/' \
    /mnt/boot/efi/EFI/zefosa/refind.conf
echo 'log_level 1' >> /mnt/boot/efi/EFI/zefosa/refind.conf
chroot /mnt zefosa-boot cmdline -a "rw console=ttyS0,115200" zroot/ROOT
zfs get -H -o value org.zfsbootmenu:commandline zroot/ROOT
install -m 0755 /root/t/target-test.sh /mnt/usr/local/sbin/target-test.sh
cp /root/t/target-test.service /mnt/etc/systemd/system/
ln -sf ../target-test.service /mnt/etc/systemd/system/multi-user.target.wants/target-test.service
umount /mnt/sys /mnt/proc /mnt/dev /mnt/boot/efi
zfs snapshot zroot/ROOT/os@base
zfs umount zroot/ROOT/os
# negative boot environment: the same OS with the kernel's signature removed
zfs clone -o mountpoint=/ -o canmount=noauto zroot/ROOT/os@base zroot/ROOT/unsigned
zfs mount zroot/ROOT/unsigned
cp /root/t/vmlinuz-unsigned /mnt/boot/vmlinuz-$UNAME
zfs umount zroot/ROOT/unsigned
zpool export zroot
echo "=== BUILDER DONE"
systemctl poweroff
